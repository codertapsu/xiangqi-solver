# ---------------------------------------------------------------------------
# Xiangqi Solver Backend - environment example
# Copy to .env to override. EVERY value has a safe mock default so the app
# runs with ZERO configuration (AI_PROVIDER=mock, ENGINE_PROVIDER=mock).
# Do NOT commit a real .env (it is git-ignored).
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000

# Provider selection. `mock` keeps everything offline & deterministic for dev.
# For a real deployment use OpenAI (the recommended default) — see below.
AI_PROVIDER=mock
ENGINE_PROVIDER=mock
# Operator authority. The analysis endpoints accept an optional per-request
# provider/engineProvider, and by default the server HONORS it (so a dev client
# can ask for `mock`). Set these to true in PRODUCTION so the server ALWAYS uses
# AI_PROVIDER/ENGINE_PROVIDER above, ignoring what the app sends — this is what
# lets you switch the fleet's cloud vision (e.g. openai → gemini) for
# ALREADY-INSTALLED apps with a restart, no app release. Keep them false for
# dev/e2e (which force `mock` per-request).
AI_PROVIDER_ENFORCE=true
ENGINE_PROVIDER_ENFORCE=false

# AI vision (cloud board-reading). All providers run the SAME prompt + parser →
# identical board JSON, so switching is a one-value change here:
#   • OpenAI (recommended default):  AI_PROVIDER=openai   + OPENAI_API_KEY     (model gpt-5.4)
#   • Gemini 3 Flash (cheaper/faster): AI_PROVIDER=gemini  + GEMINI_API_KEY    (model gemini-3.5-flash)
#   • api.apikey.fun (OpenAI-compatible aggregator): AI_PROVIDER=apikeyfun + APIKEYFUN_API_KEY (model gpt-5.5)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GEMINI_MODEL=gemini-3.5-flash
# api.apikey.fun — an OpenAI-compatible aggregator (Bearer auth, SSE streaming).
# Set AI_PROVIDER=apikeyfun to route cloud vision through it.
APIKEYFUN_API_KEY=
APIKEYFUN_MODEL=gpt-5.5

# Device-gated Codex HTTP bridge. A screenshot/extraction request whose
# x-device-id appears in <HINTS_DATA_DIR>/local-codex-vision-devices.json tries
# this provider first; all other devices use the normal AI_PROVIDER. Any Local
# Codex failure falls back to that normal provider.
# LOCAL_CODEX_URL is a base URL; the provider appends /chat. Ngrok's public
# HTTPS URL uses port 443; 5611 is only the bridge's local forwarding target.
LOCAL_CODEX_URL=https://codertapsu.ngrok.app
# Optional bridge bearer token. Empty omits the Authorization header.
LOCAL_CODEX_TOKEN=
# Empty model/effort values inherit the bridge's defaults. A vision-cascade
# model override takes precedence over LOCAL_CODEX_MODEL for that attempt.
LOCAL_CODEX_MODEL=
LOCAL_CODEX_REASONING_EFFORT=
# The bridge's default deadline is 600 seconds; allow 20 seconds for its response
# and confirmed one-time conversation cleanup to reach this backend.
LOCAL_CODEX_TIMEOUT_MS=620000

# Which local bridge an allowlisted device tries: codex | claude | none.
# EXACTLY ONE runs — the two bridges share a device allowlist and a fallback
# path, so this is a single slot rather than two flags that could contradict
# each other. `none` keeps every device on AI_PROVIDER.
AI_LOCAL_VISION_PROVIDER=codex

# Device-gated Mother Claude HTTP bridge (used when AI_LOCAL_VISION_PROVIDER=claude).
# LOCAL_CLAUDE_URL is a base URL; the provider appends /threads. The default is
# the bridge's loopback port, so a backend on any other host needs a tunnel URL.
# Note the bridge does not listen until it is STARTED from the Mother Claude app.
LOCAL_CLAUDE_URL=http://127.0.0.1:5612
# Optional bridge bearer token. Empty omits the Authorization header — fine on
# loopback, but set one (and enable it on the bridge) if you expose a tunnel.
LOCAL_CLAUDE_TOKEN=
# Empty model/effort values inherit the defaults chosen on the bridge's API
# screen. A vision-cascade model override takes precedence for that attempt.
LOCAL_CLAUDE_MODEL=
LOCAL_CLAUDE_EFFORT=
# Working directory for the one-shot conversation; empty uses the bridge default.
# A board read touches no files, so this only decides where it is rooted.
LOCAL_CLAUDE_CWD=
LOCAL_CLAUDE_PERMISSION_MODE=default
# A vision turn should take seconds. Failing fast is what lets the cloud
# fallback answer while the user is still waiting.
LOCAL_CLAUDE_TIMEOUT_MS=180000

# Optional cap on the model's output tokens. 0 = OFF (default; current behavior
# unchanged, never truncates a reasoning model). For a NON-reasoning model set
# e.g. 1536 to bound a runaway generation (the grid response is ~250 tokens). A
# truncated completion is surfaced as a clear VISION_OUTPUT_TRUNCATED error
# (raise the cap), never silently retried.
VISION_MAX_OUTPUT_TOKENS=0
# Retry a TRANSIENT vision failure (429/5xx/timeout/empty) this many times with
# short backoff. 4xx and unreadable-board 200s are never retried.
VISION_MAX_RETRIES=1
# Optional accuracy CASCADE (default off): when the primary read is unusable
# (no board / a general missing) or below VISION_CASCADE_MIN_CONFIDENCE, re-run
# once on a STRONGER model (same provider) — a second call only on hard boards.
# VISION_CASCADE_MODEL must be valid for the active provider (e.g. gpt-5.4 when
# the primary is a cheaper/faster model).
VISION_CASCADE_ENABLED=false
VISION_CASCADE_MODEL=
VISION_CASCADE_MIN_CONFIDENCE=0

# Engine (only needed when ENGINE_PROVIDER=pikafish)
# Point at the Pikafish build for YOUR OS/arch and `chmod +x` it:
#   macOS Apple Silicon -> MacOS/pikafish-apple-silicon
#   Linux x86-64        -> Linux/pikafish-<isa>   (avx2 is the safe default)
#   Windows             -> Windows\pikafish-<isa>.exe
# On macOS also clear the download quarantine: xattr -d com.apple.quarantine <file>
PIKAFISH_BINARY_PATH=
# Absolute path to pikafish.nnue (ships at the Pikafish package root).
# If left empty, Pikafish looks for "pikafish.nnue" next to the binary.
PIKAFISH_NNUE_PATH=
# UCI variant. Leave EMPTY for Pikafish. For a COMMERCIAL deployment, point
# PIKAFISH_BINARY_PATH at Fairy-Stockfish + PIKAFISH_NNUE_PATH at the CC0 xiangqi
# net, and set this to 'xiangqi' (the variant is selected before the net loads).
ENGINE_UCI_VARIANT=
ENGINE_DEFAULT_DEPTH=12
ENGINE_DEFAULT_MOVE_TIME_MS=1000
# Pikafish UCI options (ignored by the mock engine). NOTE: Pikafish has NO
# "Skill Level"/"UCI_Elo" — to make it play faster (not weaker) lower the depth
# or move time above. Threads/Hash tune speed & quality; MultiPV returns the
# top-N ranked candidate moves.
ENGINE_THREADS=1
ENGINE_HASH_MB=128
ENGINE_MULTIPV=1
ENGINE_MOVE_OVERHEAD_MS=10
# Warm engine pool: persistent engine processes reused across requests (the
# NNUE net + hash load happens once per process, not per solve). Also the hard
# cap on CONCURRENT searches — extra requests queue. ~1 per spare CPU core.
ENGINE_POOL_SIZE=2
# Spawn + warm ONE engine at boot so the FIRST solve doesn't pay the cold start
# (process spawn + ~50 MB NNUE load). Independent of ENGINE_KEEP_WARM below: with
# prewarm on, an engine is warmed at boot even if keepWarm=0 (it's then reaped
# once idle). Set false to never spawn at boot. No-op for ENGINE_PROVIDER=mock.
ENGINE_PREWARM=true
# Keep at least this many engines warm AFTER they go idle (the idle reaper never
# drops below it), so a low-traffic server doesn't cold-start on each session's
# first solve. 0 = reap everything once idle (boot pre-warm still applies above).
ENGINE_KEEP_WARM=1

# Vision-image normalization (before the image is base64'd into the AI call).
# Providers downscale internally anyway (OpenAI "high" detail: fit in 2048px,
# then shortest side 768px), so excess pixels only cost upload time + tiles.
# Mirroring that budget server-side cuts a 1-8 MB phone PNG to a ~100-300 KB
# JPEG with pixel-identical model input. Disable with VISION_PREPROCESS=false.
VISION_PREPROCESS=true
VISION_IMAGE_SHORT_SIDE=768
VISION_IMAGE_LONG_SIDE=2048

# Upload limits
MAX_UPLOAD_BYTES=8388608

# Rate limiting
# Which reverse-proxy hops Express may trust for the client IP. Empty = none
# (req.ip is the socket peer), which is right when the app talks to this process
# directly. Behind the bundled Caddy config (deploy/Caddyfile -> 127.0.0.1:3000)
# set TRUST_PROXY=loopback, or BOTH IP caps below see only Caddy and become one
# fleet-wide bucket. Never set `true` unless the proxy in front REPLACES
# X-Forwarded-For — a spoofable header would let callers escape metering.
TRUST_PROXY=

# Global per-IP throttle (all endpoints): RATE_LIMIT_LIMIT requests / RATE_LIMIT_TTL s.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=30
# Per-device cap for the (paid) analysis endpoints, keyed by the x-device-id
# header. Hints are a device-local counter on the client, so this is the cheap
# server-side abuse cap that bounds OpenAI cost per device. Default: 100 / day.
RATE_LIMIT_DEVICE_WINDOW_SECONDS=86400
RATE_LIMIT_DEVICE_LIMIT=1000
# Companion cap on the SOURCE IP over the same window, counted on EVERY analysis
# request rather than only when x-device-id is absent. The header is
# client-controlled, so without this a caller rotating it would get a fresh empty
# bucket per request and never hit RATE_LIMIT_DEVICE_LIMIT. 0 = AUTO: five times
# RATE_LIMIT_DEVICE_LIMIT — looser than the device cap because several phones
# legitimately share one NAT, and derived so raising the device cap can't leave a
# lower IP cap behind as everyone's real limit. Note: req.ip is the socket peer,
# so behind a reverse proxy set TRUST_PROXY above or the whole fleet shares one
# bucket.
RATE_LIMIT_IP_LIMIT=0

# Runtime device data (gitignored; put on a persistent volume in prod):
#   installs.json  — auto-managed ledger of devices already granted the free hints
#                    (so reinstalling does NOT re-grant them).
#   grants.json    — manual "Hint Grants" allowlist you edit by hand to comp a
#                    device a custom balance on every (re)install (higher priority
#                    than the ledger; re-read live, no restart needed). Format:
#                      { "<deviceId>": 1000 }
#                    Get the deviceId from the app's Settings → "Device ID".
#   local-codex-vision-devices.json — devices allowed to try the selected local
#                    bridge (Codex or Claude) first; one list serves both.
#                    Object keys are exact device IDs; values are ignored and may
#                    be notes; `_`-prefixed keys are comments. Re-read on change:
#                      { "_comment": "Local Codex", "<deviceId>": "test phone" }
#                    Missing/invalid files mean an empty allowlist and normal
#                    AI_PROVIDER routing. The release rsync excludes data/, so
#                    provision this file separately on every deployed server.
HINTS_DATA_DIR=./data

# Error/failure logs. Directory for date-grouped JSON-lines files
# (<LOGS_DIR>/<YYYY-MM-DD>.log) written by the global exception filter (every
# failed request) and the OpenAI provider (request failures + unparseable
# "can't extract the screenshot" responses, with diagnostic detail). Gitignored;
# put it on a persistent volume in prod. The deploy rsync keeps it via --exclude.
LOGS_DIR=./logs

# Remote config / feature flags — served by GET /api/config so the app is tunable
# without a new release. Change here + restart; the app picks them up on launch.
FEATURE_REWARDED_ADS=false        # rewarded ads = capped loss-leader → default off
FEATURE_BANNER_ADS=true           # banners = primary ad format
FEATURE_APP_OPEN_ADS=false
FEATURE_USE_REAL_ADS=false        # use REAL ad units (vs Google test units) → default off
HINTS_FREE_ON_INSTALL=10
HINTS_OWN_KEY_DIVISOR=3            # with the user's OWN OpenAI key: 1 hint per N analyses
# How many of the most-recent analyzed screenshots the app keeps on the device
# when the user turns on "Store screenshots". History shows the image for the
# last N analyses; older ones are pruned. Tunable from the server (0..100).
STORED_SCREENSHOTS_MAX=5
ONDEVICE_ENABLED=true
# Absolute URL the app downloads the on-device NNUE net from (sent to the app in
# /api/config). Point it at THIS backend's own endpoint so the net comes from us,
# not GitHub (which 504'd). Must be reachable by the app over HTTP.
ONDEVICE_NET_URL=http://103.157.205.175:3000/api/engine/net
# Server-side file served at GET /api/engine/net. The ON-DEVICE master-net —
# exactly ONDEVICE_NET_BYTES bytes, a DIFFERENT file from the server engine's
# PIKAFISH_NNUE_PATH. scripts/build-release.sh stages it here (with a size check)
# from ONDEVICE_NET_SRC and pins this path in the release .env.
ONDEVICE_NET_PATH=./release/engine/master-net.nnue
ONDEVICE_NET_BYTES=50760458       # expected size of the net (app verifies the download)
# Default OpenAI model for the app's on-device (BYO-key) board reading. On-device
# vision is OpenAI-only; users may override it in Settings. Use a capable model.
ONDEVICE_VISION_MODEL=gpt-5.4

# Visibility of OPTIONAL settings sections — all HIDDEN by default. Flip to true
# to reveal these power-user / debug sections in the app without a new release.
FEATURE_UI_BACKEND=false          # the "Backend" URL / connection-test card
FEATURE_UI_PROVIDERS=false        # the AI/engine "Providers" dropdowns
FEATURE_UI_ENGINE_TUNING=false    # the "Engine tuning" sliders (depth/threads/…)
FEATURE_UI_VISION_MODEL=false     # the on-device "Vision model" field
FEATURE_UI_LICENSES=false         # the "Open-source licenses" entry (GPLv3 notice)
FEATURE_UI_DEVICE_ID=false        # the "Device ID" tile (users share it for a Hint Grant)

# Launcher icon + name variant. 'auto' = follow the in-app App-language; 'vi'/'en'
# force one. Switches among the icons BUNDLED in the app (Android can't apply a
# runtime-downloaded image — new artwork needs an app release).
APP_ICON_VARIANT=auto             # auto | vi | en

# Admin API. Shared secret that AUTHORIZES admin actions from the app (editing
# remote config, hint grants, the install ledger). Leave EMPTY to DISABLE the
# admin write API (fail closed). Admins are identified by device id in
# <HINTS_DATA_DIR>/admins.json AND must present this secret (x-admin-secret).
# Use a long random value, e.g. `openssl rand -hex 32`.
ADMIN_SECRET=
